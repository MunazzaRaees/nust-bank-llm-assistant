import json
import pickle
from pathlib import Path

import faiss
import numpy as np
import pandas as pd
from langchain_text_splitters import RecursiveCharacterTextSplitter
from sentence_transformers import SentenceTransformer
from tqdm.auto import tqdm



# 1. Load processed knowledge

DATA_PATH = Path("../data/processed/master_bank_knowledge.json")
OUTPUT_DIR = Path("../data/processed")
FAISS_PATH = OUTPUT_DIR / "bank_faiss.index"
MAPPING_PATH = OUTPUT_DIR / "text_mapping.pkl"

with open(DATA_PATH, "r", encoding="utf-8") as f:
    data = json.load(f)

df = pd.DataFrame(data)

required_columns = ["sheet", "topic", "question", "answer"]
missing_columns = [col for col in required_columns if col not in df.columns]
if missing_columns:
    raise ValueError(f"Missing required columns in input data: {missing_columns}")

df["prepared_text"] = (
    "Category: " + df["sheet"].astype(str)
    + " | Topic: " + df["topic"].astype(str)
    + " | Question: " + df["question"].astype(str)
    + " | Answer: " + df["answer"].astype(str)
)



# 2. Split text into chunks

splitter = RecursiveCharacterTextSplitter(
    chunk_size=500,
    chunk_overlap=100
)

text_mapping: dict[int, dict] = {}
chunk_id = 0

for row_idx, row in df.iterrows():
    source_question = str(row["question"])
    source_sheet = str(row["sheet"])
    source_topic = str(row["topic"])
    text = str(row["prepared_text"])

    chunks = splitter.split_text(text)

    for chunk_text in chunks:
        text_mapping[chunk_id] = {
            "chunk_text": chunk_text,
            "question": source_question,
            "sheet": source_sheet,
            "topic": source_topic,
            "source_row_index": int(row_idx),
        }
        chunk_id += 1

if not text_mapping:
    raise ValueError("No chunks were produced. Check the source JSON or splitter settings.")

chunk_texts = [text_mapping[i]["chunk_text"] for i in range(len(text_mapping))]
print(f"Prepared {len(chunk_texts)} chunks for embedding.")



# 3. Load embedding model

print("Loading embedding model...")
embed_model = SentenceTransformer("all-MiniLM-L6-v2")



# 4. Generate embeddings

print(f"Encoding {len(chunk_texts)} chunks...")
BATCH_SIZE = 64
embedding_parts: list[np.ndarray] = []

for start in tqdm(range(0, len(chunk_texts), BATCH_SIZE), desc="Embedding batches", unit="batch"):
    batch = chunk_texts[start:start + BATCH_SIZE]
    batch_vectors = embed_model.encode(
        batch,
        show_progress_bar=False,
        convert_to_numpy=True
    )
    embedding_parts.append(np.asarray(batch_vectors, dtype=np.float32))

vectors = np.vstack(embedding_parts)

if vectors.ndim != 2 or vectors.shape[0] != len(chunk_texts):
    raise ValueError("Embedding output shape is invalid.")

print(f"Generated embeddings with shape: {vectors.shape}")



# 5. Build FAISS index

dimension = vectors.shape[1]
index = faiss.IndexFlatL2(dimension)
index.add(vectors)

print(f"FAISS index created with {index.ntotal} vectors and dimension {dimension}.")



# 6. Save artifacts

OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

faiss.write_index(index, str(FAISS_PATH))

with open(MAPPING_PATH, "wb") as f:
    pickle.dump(text_mapping, f)

print("Successfully saved artifacts:")
print(f" - FAISS index: {FAISS_PATH.resolve()}")
print(f" - Text mapping: {MAPPING_PATH.resolve()}")
print(f"Done: {len(text_mapping)} chunks indexed.")
